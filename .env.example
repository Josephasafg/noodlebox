# Copy to .env to have the tab-video reader name printed shapes by itself.
#
# With these unset the reader works exactly as it always has: it shows you each
# distinct shape once per font and you name them, which is then remembered. With
# them set, a vision model reads the shapes first and only what it declined to
# name is asked about.
#
# `.env` and `.env.local` are both read (`.local` wins) and both are ignored by
# git, so a token belongs in either. Anything already exported in the shell wins
# over both.

# Base URL of an OpenAI-compatible vision endpoint. Unset disables all of this;
# nothing leaves the machine until this has a value.
# TABVIDEO_VLM_URL=http://127.0.0.1:8000/v1

# The model as that endpoint serves it. Required alongside the URL.
# TABVIDEO_VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# Only where the server wants one.
# TABVIDEO_VLM_KEY=

# Independent looks at each shape, taken from different systems in the video. A
# name is used only if they agree, so lowering this to 1 removes that check.
# TABVIDEO_VLM_EXEMPLARS=3

# Requests in flight, seconds per request, and seconds for the whole naming step.
# When the budget runs out the rest of the shapes are left unnamed rather than
# holding the import open.
# TABVIDEO_VLM_CONCURRENCY=4
# TABVIDEO_VLM_TIMEOUT=60
# TABVIDEO_VLM_BUDGET=300

# Where the reader listens. Vite proxies /api here, and reads this same value.
# TABVIDEO_PORT=8787
